# Database
DATABASE_URL=mysql://user:password@localhost:3306/sl_tracker

# API Authentication
API_SECRET_KEY=change-this-to-a-random-secret-key

# Application
APP_ENV=dev
APP_SECRET=change-this-to-a-random-secret

# Authelia (optional) — set to any non-empty value to enable header-based auth
# and disable the built-in login page. Requires a reverse proxy (Authelia) to
# inject the Remote-User header.
# AUTHELIA_ENABLED=true
